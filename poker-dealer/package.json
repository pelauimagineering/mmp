{
  "name": "poker-dealer",
  "version": "1.0.0",
  "description": "A digital card dealer for in-person sessions of a Texas Hold'em poker game",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:reset": "node server/index.js --reset",
    "dev": "node --watch server/index.js",
    "db:init": "node scripts/init-db.js",
    "postinstall": "node scripts/sync-design-system.js",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "build:watch": "vite build --watch"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "card-dealer",
    "websocket",
    "game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/besley": "^5.3.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
